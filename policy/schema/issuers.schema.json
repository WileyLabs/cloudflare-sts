{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-sts.example.com/schema/issuers.schema.json",
  "title": "cf-sts issuers",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "iss", "jwks"],
    "properties": {
      "type": { "type": "string", "enum": ["github", "gcp", "spiffe", "aws", "oidc"] },
      "iss": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        ]
      },
      "jwks": { "type": "string", "pattern": "^https://.+" },
      "algorithms": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1, "maxLength": 16 }
      },
      "enabled": { "type": "boolean" }
    }
  }
}
