{
  "name": "cloudflare-sts",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:policy": "node scripts/build-policy.mjs",
    "verify:policy": "node scripts/verify-policy.mjs",
    "pretest": "npm run build:policy",
    "test": "node --test",
    "dev": "npm run build:policy && wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "check:policy": "npm run build:policy && node scripts/check-policy.mjs"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "wrangler": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "description": "OIDC \u2192 short-lived Cloudflare API token broker (Cloudflare Worker)",
  "repository": {
    "type": "git",
    "url": "https://github.com/WileyLabs/cloudflare-sts.git"
  },
  "author": "John Wiley & Sons, Inc.",
  "bugs": {
    "url": "https://github.com/WileyLabs/cloudflare-sts/issues"
  },
  "homepage": "https://github.com/WileyLabs/cloudflare-sts#readme"
}
